{
	admin off
	persist_config off
	auto_https off

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	encode gzip zstd

	respond /health 200

	@api path /api /api/*
	handle @api {
		reverse_proxy {$BACKEND_UPSTREAM}
	}

	handle {
		root * dist
		try_files {path} /index.html
		file_server
	}
}